   MONGO_URI=your_mongodb_connection_string
   JWT_SECRET=your_secret_key
PORT=5000

# Pre-created clinic admin account (seeded on server start)
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@petcare.com
ADMIN_PASSWORD=admin123

# Pre-created moderator / veterinary staff account (seeded on server start)
# Staff, not a pet-owner "user" account — logs in with the same clinic
# dashboard, appointment-approval access, and nav as Clinic Admin.
MODERATOR_NAME=Veterinary Staff
MODERATOR_EMAIL=moderator@petcare.com
MODERATOR_PASSWORD=moderator123

# Email (OTP verification) — recommended for Render/Vercel (HTTPS, no SMTP ports needed)
# 1) Create a free Brevo account, 2) verify a sender address (Senders & IP),
# 3) create an API key (SMTP & API -> API Keys).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PetCare

# Alternative for local development only: Gmail SMTP with an App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=PetCare <you@gmail.com>
